# Copy to .env, fill in, then:   source .env      (.env is git-ignored; never commit API keys)

cd "$(dirname "${BASH_SOURCE[0]}")"
source .venv/bin/activate

# OpenROAD-flow-scripts install created by tools/setup_orfs.sh (contains rootfs/, ~4 GB + ~0.5 GB per kept run)
export ORFS_HOME=/path/to/orfs
# Extra host dirs to expose inside the ORFS sandbox, if the repo/TMPDIR aren't enough
# export ORFS_SANDBOX_BINDS="/scratch"

# Caches / temp files (point these at a disk with space)
export PIP_CACHE_DIR=$HOME/.cache/statetune/pip
export HF_HOME=$HOME/.cache/statetune/hf
export TMPDIR=/tmp
# The MiniLM embedding model is read from third_party/RAG-EDA/MiniLM-L6-v2; don't hit the network for it
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
# Print progress immediately when stdout is redirected to a file
export PYTHONUNBUFFERED=1

# ---- LLM API ----
# Our runs used the official DeepSeek API with llm.cot_model = llm.generation_model = "deepseek-flash".
# Any OpenAI-compatible endpoint works: set the URL/key here and the model names in the YAML.
export PROVIDER_BASE_URL=https://api.deepseek.com
export PROVIDER_API_KEY=""
# Only needed if a model name contains "qwen" (routed to Alibaba DashScope)
export DASHSCOPE_API_KEY=""
