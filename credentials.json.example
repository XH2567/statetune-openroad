{
  "host": "your.cluster.hostname",
  "port": 22,
  "username": "your_user",
  "auth": {
    "type": "key",
    "key_path": "~/.ssh/id_rsa",
    "_comment_password_auth": "If you must use password auth, replace the 'auth' block with: {\"type\": \"password\", \"password\": \"...\"}"
  },
  "_notes": [
    "This file must NOT be committed. It is listed in .gitignore.",
    "All paths in configs/*/baseline_tuner.yaml under cadence.remote.* must also be updated to match your cluster layout.",
    "The LSF group name (lsf_group_user) is a separate field set in the YAML, not here."
  ]
}
